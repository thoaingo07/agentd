<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>agentd-host</UserSecretsId>
    <AssemblyName>agentd</AssemblyName>
    <!-- Single-file publish (build/publish.sh, T1b.6): only the agentd executable ships. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- The defaults travel inside the binary (AgentdConfiguration adds them below everything else). -->
    <EmbeddedResource Include="appsettings.json" LogicalName="agentd.appsettings.json" />
    <Content Update="appsettings*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Agentd.Bff\Agentd.Bff.csproj" />
    <ProjectReference Include="..\Agentd.Web\Agentd.Web.csproj" />
    <ProjectReference Include="..\Agentd.Mcp\Agentd.Mcp.csproj" />
    <ProjectReference Include="..\Agentd.Infrastructure.Persistence\Agentd.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\Agentd.Infrastructure.AzureDevOps\Agentd.Infrastructure.AzureDevOps.csproj" />
    <ProjectReference Include="..\Agentd.Infrastructure.Git\Agentd.Infrastructure.Git.csproj" />
    <ProjectReference Include="..\Agentd.Infrastructure.Claude\Agentd.Infrastructure.Claude.csproj" />
    <ProjectReference Include="..\Agentd.Infrastructure.Messaging.Discord\Agentd.Infrastructure.Messaging.Discord.csproj" />
    <ProjectReference Include="..\Agentd.Migrator\Agentd.Migrator.csproj" />
    <ProjectReference Include="..\Agentd.ServiceDefaults\Agentd.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Agentd.Host.Tests" />
  </ItemGroup>
</Project>
