            "type": [
              "null",
              "string"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "description": "A job\u0027s changes; \u0060unifiedDiff\u0060 is null when \u0060truncated\u0060 (over 2 MB), leaving the file list."
      },
      "EstimateVm": {
        "required": [
          "minutes",
          "usagePercent",
          "usageAtPlan",
          "submittedAt",
          "approvedAt"
        ],
        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "format": "int32"
          },
          "usagePercent": {
            "type": "integer",
            "format": "int32"
          },
          "usageAtPlan": {
